{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/neon-auth/:path*", "destination": "/api/neon-auth" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/caddie.js": {
      "maxDuration": 30
    },
    "api/speak.js": {
      "maxDuration": 15
    }
  }
}
